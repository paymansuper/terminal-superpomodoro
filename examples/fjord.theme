# Example custom theme for SuperPomodoro.
# Copy it to ~/.config/superpomodoro/themes/ and run: spomo --theme fjord

extends = "tokyo-night"

focus   = "#5e81ac #88c0d0"
break   = "#a3be8c #ebcb8b"
long    = "#b48ead #88c0d0"

text    = "#eceff4"
muted   = "#4c566a"
surface = "#3b4252"

scene   = "waves"

# image = "~/Pictures/fjord.jpg"
# image_brightness = 0.4
